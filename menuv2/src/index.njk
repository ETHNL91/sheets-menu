{% if menu | length == 0 %}
  <div class="alert alert-warning mt-3">
    No items found. Check your CSV / <code>MENU_CSV_URL</code>.
  </div>
{% else %}

  <div class="row g-3">
    {% for item in menu %}
      <div class="col-12 col-sm-6 col-md-4 col-lg-3">
        {% include "card.njk" %}
      </div>
    {% endfor %}
  </div>

{% endif %}
