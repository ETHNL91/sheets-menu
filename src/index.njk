{# FILE: src/index.njk #}
---
title: "ETHNL"
layout: "layout.njk"
---

{% set groups = menu | byCategory %}
{% if groups.length == 0 %}
  <div class="alert alert-info">No items available right now. Check back soon!</div>
{% endif %}

{% for cat, items in groups %}
<section class="mb-4" data-category="{{ cat }}">
  <h2 class="h4 mb-3">{{ cat }}</h2>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
    {% for item in items %}
      {% set item = item %}{% include "card.njk" %}
    {% endfor %}
  </div>
</section>
{% endfor %}
