{# FILE: src/index.njk #}
---
pagination: false
layout: false
title: Menu
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>
<body>

  <h1>{{ title }}</h1>

  {# Debug: ensure template receives all items from data (# visible reported in logs) #}
  <p class="muted">Items received: {{ menu | length }}</p>

  <div class="grid">
    {# IMPORTANT: No extra filtering or slicing. Just render what menu.js returns. #}
    {% for item in menu %}
      <article class="card">
        <h2>{{ item.name }}</h2>
        {% if item.image_url %}
          <img src="{{ item.image_url }}" alt="{{ item.name }}" style="width:100%;height:auto;border-radius:8px;margin:.5rem 0;" loading="lazy">
        {% endif %}
        <p class="muted">{{ item.category }}{% if item.featured %} • Featured{% endif %}</p>
        {% if item.description %}<p>{{ item.description }}</p>{% endif %}
        {% if item.priceNumber %}<p><strong>\${{ item.priceNumber }}</strong></p>{% endif %}

        {% if item.tags and item.tags.length %}
          <ul class="inline">
            {% for t in item.tags %}
              <li class="tag">{{ t }}</li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if item.strains and item.strains.length %}
          <div class="strains">
            <strong>Strains</strong>
            <ul>
              {% for s in item.strains %}
                <li>
                  {{ s.name }}{% if s.priceNumber %} — \${{ s.priceNumber }}{% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        {% if item.price_breakdown and item.price_breakdown.length %}
          <div class="breakdown">
            <strong>Flower breakdown</strong>
            <ul>
              {% for b in item.price_breakdown %}
                <li>{{ b.label }} — \${{ b.price }}</li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </article>
    {% endfor %}
  </div>

</body>
</html>
