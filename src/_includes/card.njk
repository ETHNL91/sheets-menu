{# FILE: src/_includes/card.njk #}
<article class="card h-100">
  <div class="card-body">
    <h3 class="h6 mb-2">{{ item.name }}</h3>

    {% if item.image_url %}
      <img src="{{ item.image_url }}" alt="{{ item.name }}" class="img-fluid mb-2" loading="lazy">
    {% endif %}

    {% if item.description %}
      <p class="mb-2">{{ item.description }}</p>
    {% endif %}

    {% if item.priceNumber %}
      <p class="mb-2"><strong>\${{ item.priceNumber }}</strong></p>
    {% endif %}

    {% if item.tags and item.tags.length %}
      <ul class="list-inline small mb-2">
        {% for t in item.tags %}
          <li class="list-inline-item badge bg-light text-dark">{{ t }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if item.strains and item.strains.length %}
      <div class="mb-2">
        <strong class="small">Strains</strong>
        <ul class="mb-0 small">
          {% for s in item.strains %}
            <li>{{ s.name }}{% if s.priceNumber %} — \${{ s.priceNumber }}{% endif %}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% if item.price_breakdown and item.price_breakdown.length %}
      <div class="mb-0">
        <strong class="small">Flower breakdown</strong>
        <ul class="mb-0 small">
          {% for b in item.price_breakdown %}
            <li>{{ b.label }} — \${{ b.price }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>
</article>
