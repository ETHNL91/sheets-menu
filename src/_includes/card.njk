<div class="col">
  <article class="card h-100 shadow-sm menu-card"
           data-name="{{ item.name | lower }}"
           data-tags="{{ item.tags | join(' ') | lower }}"
           data-category="{{ item.category }}"
           data-featured="{{ item.featured }}">
    {% if item.image_url %}
    <img src="{{ item.image_url }}" class="card-img-top" alt="{{ item.name }}">
    {% endif %}

    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start mb-1">
        <div>
          <h3 class="h5 card-title mb-1">{{ item.name }}</h3>
        </div>

        {% if item.priceNumber %}
          {% set isFlower = item.category and item.category | lower == "flower" %}
          <div class="text-end">
            <div class="badge text-bg-warning">
              {{ item.priceNumber | currency }}
            </div>
            <div class="small text-secondary">
              {% if isFlower %}
                / oz
              {% else %}
                / unit
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>

      {% if item.description %}
      <p class="card-text text-secondary mb-2">{{ item.description }}</p>
      {% endif %}
      {% if item.strains and item.strains.length %}
  <p class="small text-secondary mb-1">Available strains:</p>
  <div class="d-flex flex-wrap gap-1 mb-2">
    {% for s in item.strains %}
      <span class="badge text-bg-secondary">
        {{ s.name }}
        {% if s.priceNumber %}
          • {{ s.priceNumber | currency }}
        {% endif %}
      </span>
    {% endfor %}
  </div>
{% endif %}


      

      {# Price breakdown list: only for Flower with breakdown rows #}
      {% if item.price_breakdown and item.price_breakdown.length %}
      <ul class="list-unstyled small mb-2">
        {% for row in item.price_breakdown %}
        <li class="d-flex justify-content-between">
          <span>{{ row.label }}</span>
          <span>{{ row.price | currency }}</span>
        </li>
        {% endfor %}
      </ul>
      {% endif %}



      {% if item.featured %}
      <span class="badge text-bg-success mt-2">Featured</span>
      {% endif %}
    </div>
  </article>
</div>
