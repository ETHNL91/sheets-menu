<div class="col">
  <article class="card h-100 shadow-sm menu-card"
           data-name="{{ item.name | lower }}"
           data-tags="{{ item.tags | join(' ') | lower }}"
           data-category="{{ item.category }}"
           data-featured="{{ item.featured }}">
    {% if item.image_url %}
    <img src="{{ item.image_url }}" class="card-img-top" alt="{{ item.name }}">
    {% endif %}
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start">
        <h3 class="h5 card-title mb-2">{{ item.name }}</h3>
        {% if item.price %}
        <span class="badge text-bg-warning">{{ item.price | currency }}</span>
        {% endif %}
      </div>
      {% if item.description %}
      <p class="card-text text-secondary">{{ item.description }}</p>
      {% endif %}
      {% if item.tags.length %}
      <div class="d-flex flex-wrap gap-2 mt-2">
        {% for t in item.tags %}
        <span class="badge text-bg-secondary">#{{ t }}</span>
        {% endfor %}
      </div>
      {% endif %}
      {% if item.featured %}
      <span class="badge text-bg-success mt-2">Featured</span>
      {% endif %}
    </div>
  </article>
</div>
