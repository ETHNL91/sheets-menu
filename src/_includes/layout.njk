<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Menu" }}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">Menu</a>
    </div>
  </nav>

  <header class="container py-3">
    <h1 class="h2 mb-1">{{ title or "Menu" }}</h1>
    <p class="text-secondary mb-3">Updated automatically from Google Sheets</p>

    <form class="row gy-2 gx-2 align-items-center">
      <div class="col-sm-5">
        <input id="search" type="search" class="form-control" placeholder="Search by name or tag…">
      </div>
      <div class="col-sm-4">
        <select id="category" class="form-select">
          <option value="">All categories</option>
          {% for cat, items in menu | byCategory %}
          <option value="{{ cat }}">{{ cat }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-sm-3 form-check ps-4">
        <input class="form-check-input" type="checkbox" id="featuredOnly">
        <label class="form-check-label" for="featuredOnly">Featured only</label>
      </div>
    </form>
  </header>

  <main class="container pb-5">
    {{ content | safe }}
  </main>

  <footer class="container border-top pt-3 pb-5">
    <small class="text-secondary">&copy; {{ "now" | date("yyyy") }} — Powered by Eleventy</small>
  </footer>

  <script>
  (function() {
    const q = document.getElementById("search");
    const sel = document.getElementById("category");
    const featured = document.getElementById("featuredOnly");
    const cards = Array.from(document.querySelectorAll(".menu-card"));

    function apply() {
      const term = (q?.value || "").toLowerCase().trim();
      const cat = sel?.value || "";
      const onlyFeatured = featured?.checked || false;

      cards.forEach(card => {
        const name = (card.dataset.name || "");
        const tags = (card.dataset.tags || "");
        const category = (card.dataset.category || "");
        const isFeatured = card.dataset.featured === "true";

        const matchesTerm = !term || name.includes(term) || tags.includes(term);
        const matchesCat = !cat || category === cat;
        const matchesFeat = !onlyFeatured || isFeatured;

        card.classList.toggle("d-none", !(matchesTerm && matchesCat && matchesFeat));
      });
    }

    [q, sel, featured].forEach(el => el && el.addEventListener("input", apply));
  })();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
