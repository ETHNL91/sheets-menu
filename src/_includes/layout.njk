  <!-- Filter script -->
  <script>
    (function() {
      const q = document.getElementById("search");
      const sel = document.getElementById("category");
      const featured = document.getElementById("featuredOnly");
      const cards = Array.from(document.querySelectorAll(".menu-card"));

      function apply() {
        const term = (q?.value || "").toLowerCase().trim();
        const cat = sel?.value || "";
        const onlyFeatured = featured?.checked || false;

        cards.forEach(card => {
          const name = (card.dataset.name || "");
          const tags = (card.dataset.tags || "");
          const category = (card.dataset.category || "");
          const isFeatured = card.dataset.featured === "true";

          const matchesTerm = !term || name.includes(term) || tags.includes(term);
          const matchesCat = !cat || category === cat;
          const matchesFeat = !onlyFeatured || isFeatured;

          card.classList.toggle("d-none", !(matchesTerm && matchesCat && matchesFeat));
        });
      }

      [q, sel, featured].forEach(el => el && el.addEventListener("input", apply));
    })();
  </script>

  <!-- Dynamic hours script -->
  <script>
(function () {
  const weeklyHours = [
    { dayIndex: 0, label: "Sunday",    open: "9:00am",  close: "12:00am" },
    { dayIndex: 1, label: "Monday",    open: "9:00am",  close: "12:00am" },
    { dayIndex: 2, label: "Tuesday",   open: "9:00am",  close: "12:00am" },
    { dayIndex: 3, label: "Wednesday", open: "9:00am",  close: "9:30pm" },
    { dayIndex: 4, label: "Thursday",  open: "6:00pm",  close: "9:30pm" },
    { dayIndex: 5, label: "Friday",    open: "6:00pm",  close: "9:30pm" },
    { dayIndex: 6, label: "Saturday",  open: "6:00pm",  close: "9:30pm" },
  ];

  // Parse "9:00am", "6:30pm" OR "09:00" (24h) → minutes since midnight
  function toMinutes(str) {
    if (!str) return null;
    const s = str.trim().toLowerCase();

    // am/pm format
    const ampm = s.match(/^(\d{1,2}):(\d{2})\s*(am|pm)$/);
    if (ampm) {
      let h = parseInt(ampm[1], 10);
      const m = parseInt(ampm[2], 10);
      const mer = ampm[3];

      if (mer === "pm" && h !== 12) h += 12;
      if (mer === "am" && h === 12) h = 0; // 12:xxam → 0:xx

      return h * 60 + m;
    }

    // fallback: 24h "HH:MM"
    const parts = s.split(":");
    if (parts.length === 2) {
      const h = parseInt(parts[0], 10);
      const m = parseInt(parts[1], 10);
      if (!isNaN(h) && !isNaN(m)) {
        return h * 60 + m;
      }
    }

    return null;
  }

  const now = new Date();
  const todayIndex = now.getDay(); // 0–6
  const minsNowRaw = now.getHours() * 60 + now.getMinutes();

  const today = weeklyHours.find(h => h.dayIndex === todayIndex);
  const todayHoursEl = document.getElementById("today-hours");
  const openStatusEl = document.getElementById("open-status");
  const weeklyListEl = document.getElementById("hours-weekly");

  console.log("[hours] now =", now.toString());
  console.log("[hours] todayIndex =", todayIndex, "today =", today);

  if (!today || !todayHoursEl || !weeklyListEl) {
    console.warn("[hours] Missing DOM elements or schedule for today");
    return;
  }

  // Display today's hours text
  if (!today.open || !today.close) {
    todayHoursEl.textContent = `Today (${today.label}): Closed`;
  } else {
    todayHoursEl.textContent = `Today (${today.label}): ${today.open} – ${today.close}`;
  }

  // Compute "open now" with cross-midnight support
  if (today.open && today.close) {
    const openMins = toMinutes(today.open);
    const closeMins = toMinutes(today.close);

    if (openMins == null || closeMins == null) {
      console.warn("[hours] Could not parse times for", today);
    }

    let isOpen = false;

    if (openMins != null && closeMins != null) {
      let start = openMins;
      let end = closeMins;
      let nowMins = minsNowRaw;

      // If close <= open, treat as going past midnight
      // e.g. 9:00am–12:00am (next day) or 6:00pm–2:00am
      if (end <= start) {
        end += 24 * 60;
        if (nowMins < start) {
          nowMins += 24 * 60;
        }
      }

      isOpen = nowMins >= start && nowMins < end;

      console.log("[hours] openMins =", openMins,
                  "closeMins =", closeMins,
                  "minsNowRaw =", minsNowRaw,
                  "adjustedNow =", nowMins,
                  "isOpen =", isOpen);
    }

    if (openStatusEl) {
      openStatusEl.textContent = isOpen ? "Open now" : "Closed";
      openStatusEl.classList.remove("text-secondary");
      openStatusEl.classList.toggle("text-success", isOpen);
      openStatusEl.classList.toggle("text-danger", !isOpen);
    }
  } else if (openStatusEl) {
    openStatusEl.textContent = "Closed today";
    openStatusEl.classList.remove("text-secondary");
    openStatusEl.classList.add("text-danger");
  }

  // Weekly list
  weeklyListEl.innerHTML = "";
  weeklyHours.forEach((h) => {
    const li = document.createElement("li");
    const isToday = h.dayIndex === todayIndex;
    const displayText = (!h.open || !h.close)
      ? "Closed"
      : `${h.open} – ${h.close}`;
    li.textContent = `${h.label}: ${displayText}`;
    if (isToday) li.style.fontWeight = "600";
    weeklyListEl.appendChild(li);
  });
})();
  </script>


