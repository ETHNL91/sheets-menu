<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or 'ETHNL' }}</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  {# CRITICAL: use |url so it works locally and on GitHub Pages subpaths #}
  <link rel="stylesheet" href="./assets/css/style.css" />
</head>
<body>
  <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom">
    <div class="container">
      <a class="navbar-brand fw-bold" href="{{ '/' | url }}">WELCOME</a>
    </div>
  </nav>

  <header class="container py-3">
    <h1 class="h2 mb-1">{{ title or 'ETHNL' }}</h1>
    {# keep your contact/hours block if you want #}
    <div class="row mb-3">
      <div class="col-md-6">
        <h2 class="h6 text-uppercase text-secondary mb-1">Contact</h2>
        <p class="mb-0">
          <strong>Text / Signal:</strong> @yourhandle<br>
          <strong>Backup:</strong> +1 (555) 123-4567
        </p>
      </div>
      <div class="col-md-6">
        <h2 class="h6 text-uppercase text-secondary mb-1">Hours</h2>
        <p id="today-hours" class="mb-1">Loading hours…</p>
        <p id="open-status" class="small mb-1 text-secondary"></p>
        <ul id="hours-weekly" class="list-unstyled small mb-0"></ul>
      </div>
    </div>
  </header>

  <main class="container pb-5">
    {{ content | safe }} {# REQUIRED: renders src/index.njk content #}
  </main>

  <footer class="container border-top pt-3 pb-5">
    <small class="text-secondary">&copy; Menu — Powered by Eleventy</small>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
